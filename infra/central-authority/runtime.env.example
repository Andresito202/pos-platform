# Inventory of existing main.ts inputs; NOT a deployable configuration.
# Fill only in the deployment secret/config manager, outside Git/chat/logs.
# No environment, hostname, identity, key or policy is supplied by this file.
# Explicit opt-in profile; all limits below become mandatory, with no defaults.
CENTRAL_DEPLOYMENT_ENVIRONMENT=
CENTRAL_AUTHORITY_ORIGIN=
CENTRAL_REQUEST_TIMEOUT_MS=
CENTRAL_HEADERS_TIMEOUT_MS=
CENTRAL_SHUTDOWN_TIMEOUT_MS=
CENTRAL_AUTHORITY_PORT=
CENTRAL_DATABASE_URL=
CENTRAL_TLS_KEY_FILE=
CENTRAL_TLS_CERT_FILE=
D3_ISSUER_PRIVATE_KEY_FILE=
D3_ENROLLMENT_TRANSPORT_TOKEN_FILE=
# Legacy enrollment only, mutually exclusive with the profile's managed token:
# D3_ENROLLMENT_TRANSPORT_TOKEN=
D3_ENROLLMENT_MAX_BODY_BYTES=
D3_CREDENTIAL_LIFETIME_MS=

# Optional existing SSA public-key publication: omit both unless provisioned.
# SESSION_TRUST_ARTIFACT_FILE=
# SESSION_TRUST_TRANSPORT_TOKEN_FILE=

# Optional public SAS publication: both files, separate transport token.
# AUTHORIZATION_TRUST_ARTIFACT_FILE=
# AUTHORIZATION_TRUST_TRANSPORT_TOKEN_FILE=

# Commercial V2 opt-in requires PREPRODUCTION/PRODUCTION, registered 008-016,
# real recipient/identity/device and verified access/SSA/SAS operational keys.
# All policies (including http_maximum_buckets) are explicit inside this file.
# Does not create a deployment, user, device or approval by setting the path.
# CENTRAL_COMMERCIAL_PROVISION_FILE=
