{
  "name": "pos-platform-target",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "architecture:check": "nx run pos-platform-target:architecture-check",
    "ci:repository-policy": "node tools/ci/validate-repository-policy.mjs",
    "ci:dependency-inventory": "node tools/ci/generate-dependency-inventory.mjs",
    "preflight:migration:003": "pnpm --filter @pos-platform/target-migrations preflight:003",
    "role-readiness:migration:003:check": "pnpm --filter @pos-platform/target-migrations role-readiness:003:check",
    "role-readiness:migration:003:apply": "pnpm --filter @pos-platform/target-migrations role-readiness:003:apply",
    "role-readiness:migration:003:revert": "pnpm --filter @pos-platform/target-migrations role-readiness:003:revert",
    "typecheck": "pnpm --filter @pos-platform/target-migrations typecheck",
    "test:migrations": "pnpm --filter @pos-platform/target-migrations test",
    "test:migrations:postgres": "pnpm --filter @pos-platform/target-migrations test:postgres",
    "test:migrations:sqlite": "pnpm --filter @pos-platform/target-migrations test:sqlite"
  },
  "devDependencies": {
    "nx": "23.1.2",
    "typescript": "6.0.3"
  },
  "nx": {
    "targets": {
      "architecture-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test tools/architecture/validate-boundaries.test.mjs && node tools/architecture/validate-boundaries.mjs"
        }
      }
    }
  }
}
