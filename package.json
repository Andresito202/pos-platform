{
  "name": "pos-platform-target",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "architecture:check": "nx run pos-platform-target:architecture-check",
    "ci:dependency-inventory": "node tools/ci/generate-dependency-inventory.mjs",
    "ci:governance": "node --test tools/ci/active-line-consistency.test.mjs tools/ci/document-claims.test.mjs",
    "ci:license-gate": "node tools/ci/run-license-compatibility-gate.mjs",
    "ci:license-tests": "node --test tools/ci/validate-spdx-license.test.mjs tools/ci/run-license-compatibility-gate.test.mjs",
    "ci:provenance-tests": "node --test tools/ci/provenance-manifest.test.mjs",
    "ci:repository-policy": "node tools/ci/validate-repository-policy.mjs",
    "ci:sbom": "node tools/ci/generate-cyclonedx-sbom.mjs",
    "ci:supply-chain-tests": "node --test tools/ci/workspace-manifests.test.mjs tools/ci/generate-dependency-inventory.test.mjs tools/ci/validate-dependency-audit.test.mjs tools/ci/run-dependency-vulnerability-audit.test.mjs tools/ci/generate-cyclonedx-sbom.test.mjs tools/ci/validate-spdx-license.test.mjs tools/ci/run-license-compatibility-gate.test.mjs tools/ci/provenance-manifest.test.mjs",
    "ci:vulnerability-audit": "node tools/ci/run-dependency-vulnerability-audit.mjs",
    "ci:vulnerability-tests": "node --test tools/ci/validate-dependency-audit.test.mjs",
    "preflight:migration:003": "pnpm --filter @pos-platform/target-migrations preflight:003",
    "role-readiness:migration:003:apply": "pnpm --filter @pos-platform/target-migrations role-readiness:003:apply",
    "role-readiness:migration:003:check": "pnpm --filter @pos-platform/target-migrations role-readiness:003:check",
    "role-readiness:migration:003:revert": "pnpm --filter @pos-platform/target-migrations role-readiness:003:revert",
    "test:application": "pnpm --filter @pos-platform/application test",
    "test:contracts": "pnpm --filter @pos-platform/contracts test",
    "test:domain": "pnpm --filter @pos-platform/domain test",
    "test:fiscal-adapters": "pnpm --filter @pos-platform/fiscal-adapters test",
    "test:migrations": "pnpm --filter @pos-platform/target-migrations test",
    "test:migrations:postgres": "pnpm --filter @pos-platform/target-migrations test:postgres",
    "test:migrations:sqlite": "pnpm --filter @pos-platform/target-migrations test:sqlite",
    "test:runtime": "pnpm --filter @pos-platform/local-channel test && pnpm --filter @pos-platform/device-trust test && pnpm --filter @pos-platform/database-sqlite test && pnpm --filter @pos-platform/observability test && pnpm --filter @pos-platform/central-authority test && pnpm --filter @pos-platform/api test && pnpm --filter @pos-platform/pos-local-service test && pnpm --filter @pos-platform/pos-desktop test",
    "typecheck": "pnpm --filter @pos-platform/contracts typecheck && pnpm --filter @pos-platform/domain typecheck && pnpm --filter @pos-platform/application typecheck && pnpm --filter @pos-platform/database-sqlite typecheck && pnpm --filter @pos-platform/database-postgres typecheck && pnpm --filter @pos-platform/fiscal-adapters typecheck && pnpm --filter @pos-platform/observability typecheck && pnpm --filter @pos-platform/pos-local-service typecheck && pnpm --filter @pos-platform/pos-desktop typecheck && pnpm --filter @pos-platform/target-migrations typecheck && pnpm --filter @pos-platform/api typecheck"
  },
  "devDependencies": {
    "nx": "23.1.2",
    "typescript": "6.0.3"
  },
  "nx": {
    "targets": {
      "architecture-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test tools/architecture/validate-boundaries.test.mjs && node tools/architecture/validate-boundaries.mjs"
        }
      }
    }
  },
  "pnpm": {
    "overrides": {
      "smol-toml": ">=1.7.1"
    }
  }
}
