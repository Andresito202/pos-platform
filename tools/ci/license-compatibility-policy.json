{
  "schema": "pos-platform-license-compatibility-policy/v1",
  "allow": {
    "0BSD": ["preserve-license-text"],
    "Apache-2.0": ["preserve-license-text", "preserve-NOTICE-when-present"],
    "BSD-2-Clause": ["preserve-license-text"],
    "BSD-3-Clause": ["preserve-license-text"],
    "BlueOak-1.0.0": ["preserve-license-text"],
    "ISC": ["preserve-license-text"],
    "MIT": ["preserve-license-text"],
    "MPL-2.0": ["preserve-license-text", "preserve-MPL-covered-source-obligations-if-covered-files-are-modified"],
    "Python-2.0": ["preserve-license-text"]
  },
  "review": [
    "CDDL-1.0",
    "CDDL-1.1",
    "EPL-1.0",
    "EPL-2.0",
    "LGPL-2.0-only",
    "LGPL-2.0-or-later",
    "LGPL-2.1-only",
    "LGPL-2.1-or-later",
    "LGPL-3.0-only",
    "LGPL-3.0-or-later",
    "NOASSERTION",
    "NONE",
    "Unlicense"
  ],
  "deny": [
    "AGPL-1.0-only",
    "AGPL-1.0-or-later",
    "AGPL-3.0-only",
    "AGPL-3.0-or-later",
    "BUSL-1.1",
    "CC-BY-NC-4.0",
    "CC-BY-NC-SA-4.0",
    "Commons-Clause",
    "GPL-1.0-only",
    "GPL-1.0-or-later",
    "GPL-2.0-only",
    "GPL-2.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0-or-later",
    "SSPL-1.0",
    "UNLICENSED"
  ],
  "allowWith": {}
}
