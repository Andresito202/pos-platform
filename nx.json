{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tools/architecture/module-boundaries.json"
    ]
  },
  "targetDefaults": {
    "architecture-check": {
      "cache": true,
      "inputs": [
        "default",
        "sharedGlobals"
      ]
    }
  },
  "analytics": false
}