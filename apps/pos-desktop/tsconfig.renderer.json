{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": []
  },
  "include": [
    "renderer/**/*.ts",
    "renderer/**/*.tsx",
    "tests/renderer/**/*.ts",
    "tests/renderer/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
