{
  "name": "@pos-platform/pos-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "build:main": "tsc -p tsconfig.build.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "start:smoke": "electron --no-sandbox e2e/smoke-entry.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@pos-platform/contracts": "workspace:*",
    "@pos-platform/observability": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.4.3",
    "@pos-platform/local-channel": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.5.0",
    "electron": "44.1.1",
    "jsdom": "26.1.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
