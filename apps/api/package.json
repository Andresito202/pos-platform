{
  "name": "@pos-platform/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"tests/**/*.postgres.test.ts\"",
    "test:postgres": "vitest run tests/tenant-login.postgres.test.ts tests/device-login.postgres.test.ts tests/operator-session.postgres.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@pos-platform/contracts": "workspace:*",
    "@pos-platform/device-trust": "workspace:*",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
